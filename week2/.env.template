# Copy this file to .env and fill in real values:
#   cp .env.template .env
#
# .env is gitignored and must never be committed. This template is the
# only thing that should be checked into version control, so anyone
# cloning the repo knows exactly which variables they need to set.

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mydatabase

# Host the FastAPI app uses to reach Postgres.
# - "localhost" when running the app directly on your machine (the
#   docker-compose.yml only runs the db container, with its port
#   published to the host, so the app talks to it over localhost).
# - "db" if you containerize the app itself and add it to
#   docker-compose.yml as a service on the same Docker network as db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
